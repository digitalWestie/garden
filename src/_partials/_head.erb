<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<% resource_title = strip_html(strip_newlines(title)) %>
<% page_description = strip_html(strip_newlines(data.excerpt.presence || data.description.presence || metadata.description)) %>
<% feature_image = data["featureImage"].presence || data["image"].presence %>
<% page_url = absolute_url(resource.relative_url) %>
<% og_title = resource_title != "Index" ? resource_title : metadata.title %>
<title><% if resource_title != "Index" %><%= resource_title %> | <%= metadata.title %><% else %><%= metadata.title %>: <%= metadata.tagline %><% end %></title>

<meta name="description" content="<%= page_description %>" />

<meta property="og:site_name" content="<%= metadata.title %>" />
<meta property="og:title" content="<%= og_title %>" />
<meta property="og:description" content="<%= page_description %>" />
<meta property="og:type" content="<%= resource_title != "Index" ? "article" : "website" %>" />
<meta property="og:url" content="<%= page_url %>" />
<% if feature_image.present? %>
<meta property="og:image" content="<%= absolute_url(feature_image) %>" />
<% end %>

<meta name="twitter:card" content="<%= feature_image.present? ? "summary_large_image" : "summary" %>" />
<meta name="twitter:title" content="<%= og_title %>" />
<meta name="twitter:description" content="<%= page_description %>" />
<% if feature_image.present? %>
<meta name="twitter:image" content="<%= absolute_url(feature_image) %>" />
<% end %>

<link rel="stylesheet" href="<%= asset_path :css %>" />
<script src="<%= asset_path :js %>" defer></script>
<%= live_reload_dev_js %>

<!-- Privacy-friendly analytics by Plausible -->
<script async src="https://plausible.io/js/pa-zki9PilgGes3Qiey56WKq.js"></script>
<script>
  window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
  plausible.init()
</script>
